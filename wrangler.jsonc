{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hs-awase",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // フロント（Vite のビルド結果）を同じ Worker から配信する。
  // /api/* と /media/* は Worker が先に処理し、それ以外は SPA として index.html を返す。
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hs-awase",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "hs-awase-media" }
  ],
  "vars": {
    "STORAGE_LIMIT_BYTES": "9663676416",
    "PENDING_LIMIT_BYTES": "2147483648",
    "MEDIA_BASE_URL": "/media",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "TURNSTILE_SITE_KEY": ""
  },
  "observability": { "enabled": true }
}
